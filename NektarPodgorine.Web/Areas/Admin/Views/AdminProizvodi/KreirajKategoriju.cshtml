@model NektarPodgorine.Web.Models.ViewModels.KategorijaVM
@{
    ViewBag.Title = "Nova kategorija";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Nova kategorija</h1>

        @using (Html.BeginForm("KreirajKategoriju", "AdminProizvodi", new { area = "Admin" }, FormMethod.Post, new { @class = "card card-body" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Naziv, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Naziv, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Naziv, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Opis, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Opis, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Opis, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Sačuvaj</button>
                @Html.ActionLink("Odustani", "Kategorije", null, new { area = "Admin" }, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
