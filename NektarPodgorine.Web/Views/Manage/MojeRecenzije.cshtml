@model System.Collections.Generic.IEnumerable<NektarPodgorine.Web.Models.Recenzija>
@{
    ViewBag.Title = "Moje recenzije";
}

<h1 class="mb-4">Moje recenzije</h1>

@if (!Model.Any())
{
    <p>Još uvek niste ostavili nijednu recenziju.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Proizvod</th>
                <th>Ocena</th>
                <th>Komentar</th>
                <th>Datum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        @if (r.Proizvod != null)
                        {
                            @Html.ActionLink(r.Proizvod.Naziv, "Details", "Proizvodi", new { id = r.ProizvodId }, null)
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>@r.Ocena / 5</td>
                    <td>@r.Sadrzaj</td>
                    <td>@r.DatumKreiranja.ToString("dd.MM.yyyy.")</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Izmeni", "Edit", "Recenzije", new { id = r.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                        @using (Html.BeginForm("Delete", "Recenzije", new { id = r.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Obrisati recenziju?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Obriši</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p>@Html.ActionLink("Nazad na profil", "Index", null, new { @class = "btn btn-outline-secondary" })</p>
