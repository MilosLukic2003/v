@model NektarPodgorine.Web.Models.Proizvod
@{
    ViewBag.Title = Model.Naziv;
    var recenzije = Model.Recenzije ?? new System.Collections.Generic.List<NektarPodgorine.Web.Models.Recenzija>();
    var prosek = recenzije.Any() ? recenzije.Average(r => r.Ocena) : (double?)null;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">@Html.ActionLink("Proizvodi", "Index")</li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Naziv</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Naziv" />
        }
        else
        {
            <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="height:280px;">
                <span class="text-muted">Nema slike</span>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h1>@Model.Naziv</h1>
        <p class="text-muted">Kategorija: @(Model.Kategorija != null ? Model.Kategorija.Naziv : "—")</p>
        <p class="fs-4 fw-bold">@Model.Cena.ToString("0.00") RSD / @Model.JedinicaMere</p>
        <p>Na stanju: @Model.KolicinaNaStanju @Model.JedinicaMere</p>
        <p>@Model.Opis</p>
        <p class="text-muted"><small>Dodato: @Model.DatumDodavanja.ToString("dd.MM.yyyy.")</small></p>

        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2 mt-3">
                @Html.ActionLink("Izmeni", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Obriši", "Delete", new { id = Model.Id }, new { @class = "btn btn-outline-danger" })
            </div>
        }
    </div>
</div>

<hr />

<h2>Recenzije</h2>
<p>
    @if (prosek.HasValue)
    {
        <span class="fs-5">Prosečna ocena: <strong>@prosek.Value.ToString("0.0")</strong> / 5</span>
        <span class="text-muted">(@recenzije.Count() @(recenzije.Count() == 1 ? "recenzija" : "recenzija"))</span>
    }
    else
    {
        <span class="text-muted">Još nema recenzija za ovaj proizvod.</span>
    }
</p>

@foreach (var r in recenzije.OrderByDescending(r => r.DatumKreiranja))
{
    <div class="card mb-2">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <strong>@(r.Korisnik != null ? (r.Korisnik.FullName ?? r.Korisnik.Email) : "Korisnik")</strong>
                <span>@r.Ocena / 5</span>
            </div>
            <p class="mb-1">@r.Sadrzaj</p>
            <small class="text-muted">@r.DatumKreiranja.ToString("dd.MM.yyyy.")</small>
        </div>
    </div>
}

@if (!Request.IsAuthenticated)
{
    <p class="mt-3">@Html.ActionLink("Prijavite se", "Login", "Account") da biste ostavili recenziju.</p>
}
