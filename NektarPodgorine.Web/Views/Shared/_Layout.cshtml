<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Nektar Podgorine</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-nektar">
            <div class="container">
                <a class="navbar-brand py-1" href="@Url.Action("Index", "Home", new { area = "" })">
                    <img src="~/Images/logo.jpeg" alt="Nektar Podgorine" height="50" class="rounded" />
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#glavniMeni"
                        aria-controls="glavniMeni" aria-expanded="false" aria-label="Prikaži/sakrij navigaciju">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="glavniMeni">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">@Html.ActionLink("Početna", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Proizvodi", "Index", "Proizvodi", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Vesti", "Index", "Vesti", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Pčelinjaci", "Index", "Pcelinjaci", new { area = "" }, new { @class = "nav-link" })</li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administracija</a>
                                <ul class="dropdown-menu">
                                    <li>@Html.ActionLink("Korisnici", "Index", "AdminUsers", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Proizvodi", "Index", "AdminProizvodi", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Kategorije", "Kategorije", "AdminProizvodi", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Recenzije", "Index", "AdminRecenzije", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>Nektar Podgorine</h5>
                    <p class="mb-0">Porodično pčelarsko gazdinstvo Jelene i Vlada Lukića iz okoline Valjeva. Med i pčelinji proizvodi iz sopstvene proizvodnje, bez dodataka.</p>
                </div>
                <div class="col-md-4">
                    <h5>Kontakt</h5>
                    <p class="mb-1">Podgorina, 14000 Valjevo</p>
                    <p class="mb-1">Tel: <a href="tel:+381641234567">+381 64 123 4567</a></p>
                    <p class="mb-1">E-mail: <a href="mailto:info@nektarpodgorine.rs">info@nektarpodgorine.rs</a></p>
                    <p class="mb-0">Radno vreme: pon–sub, 08–18h</p>
                </div>
                <div class="col-md-4">
                    <h5>Brzi linkovi</h5>
                    <ul class="list-unstyled mb-0">
                        <li>@Html.ActionLink("Proizvodi", "Index", "Proizvodi", new { area = "" }, null)</li>
                        <li>@Html.ActionLink("Vesti", "Index", "Vesti", new { area = "" }, null)</li>
                        <li>@Html.ActionLink("Pčelinjaci", "Index", "Pcelinjaci", new { area = "" }, null)</li>
                    </ul>
                </div>
            </div>
            <div class="footer-donji text-center">
                &copy; @DateTime.Now.Year Pčelarsko gazdinstvo „Nektar Podgorine"
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
