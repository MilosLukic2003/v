<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Nektar Podgorine</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark">
            <div class="container">
                @Html.ActionLink("Nektar Podgorine", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#glavniMeni"
                        aria-controls="glavniMeni" aria-expanded="false" aria-label="Prikaži/sakrij navigaciju">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="glavniMeni">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">@Html.ActionLink("Početna", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Proizvodi", "Index", "Proizvodi", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Vesti", "Index", "Vesti", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Pčelinjaci", "Index", "Pcelinjaci", new { area = "" }, new { @class = "nav-link" })</li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administracija</a>
                                <ul class="dropdown-menu">
                                    <li>@Html.ActionLink("Korisnici", "Index", "AdminUsers", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Proizvodi", "Index", "AdminProizvodi", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Kategorije", "Kategorije", "AdminProizvodi", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Recenzije", "Index", "AdminRecenzije", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Pčelarsko gazdinstvo "Nektar Podgorine"</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
