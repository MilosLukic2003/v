@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-nav ms-auto align-items-md-center" }))
    {
        @Html.AntiForgeryToken()

        <li class="nav-item">
            @Html.ActionLink("Zdravo, " + User.Identity.GetUserName() + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Upravljanje nalogom", @class = "nav-link" })
        </li>
        if (User.IsInRole("Admin"))
        {
            <li class="nav-item"><span class="nav-link text-warning">(Administrator)</span></li>
        }
        <li class="nav-item">
            <a href="javascript:document.getElementById('logoutForm').submit()" class="nav-link">Odjava</a>
        </li>
    }
}
else
{
    <ul class="navbar-nav ms-auto">
        <li class="nav-item">@Html.ActionLink("Registracija", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", @class = "nav-link" })</li>
        <li class="nav-item">@Html.ActionLink("Prijava", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link" })</li>
    </ul>
}
