@model NektarPodgorine.Web.Models.Vest
@{
    ViewBag.Title = "Brisanje vesti";
}

<h1 class="mb-4">Brisanje vesti</h1>

<div class="alert alert-danger">Da li ste sigurni da želite da obrišete ovu vest?</div>

<dl class="row">
    <dt class="col-sm-2">Naslov</dt>
    <dd class="col-sm-10">@Model.Naslov</dd>

    <dt class="col-sm-2">Objavljeno</dt>
    <dd class="col-sm-10">@Model.DatumObjave.ToString("dd.MM.yyyy.")</dd>
</dl>

@using (Html.BeginForm("Delete", "Vesti", new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Obriši</button>
        @Html.ActionLink("Odustani", "Details", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
    </div>
}
